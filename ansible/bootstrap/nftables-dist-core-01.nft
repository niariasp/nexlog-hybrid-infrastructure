#!/usr/sbin/nft -f
# NexLog Chile - DIST-CORE-01 - politica deny-by-default (OE3)
flush ruleset

table inet nexlog {
    set gw_ips {
        type ipv4_addr
        elements = { 10.10.10.1, 10.10.20.1, 10.10.30.1, 172.27.0.1, 10.255.255.2 }
    }
    set red_protegida {
        type ipv4_addr
        flags interval
        elements = { 192.168.99.0/24, 10.255.255.0/30 }
    }

    chain input {
        type filter hook input priority filter; policy drop;
        ct state established,related accept
        ct state invalid drop
        iifname "lo" accept
        iifname "eth0" ip saddr 192.168.99.0/24 accept comment "Gestion OOB: SSH Ansible"
        iifname "eth13" udp dport 51820 accept comment "WireGuard underlay"
        ip daddr @gw_ips icmp type echo-request accept comment "Ping al gateway"
        ip daddr 192.168.99.11 counter drop comment "Gestion DIST desde red no autorizada"
        limit rate 10/minute log prefix "NEXLOG-IN-DROP " level info
        counter drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related accept
        ct state invalid drop
        ip daddr @red_protegida counter log prefix "NEXLOG-FWD-MGMT-DROP " level info drop comment "Usuarios/Site2 a gestion y transito"
        iifname { "vlan10", "vlan20" } oifname "vlan30" ip daddr 10.10.30.10 tcp dport { 80, 443 } accept comment "ADMIN/OPER a WMS web"
        iifname { "vlan10", "vlan20" } oifname "vlan30" ip daddr 10.10.30.10 icmp type echo-request accept comment "ADMIN/OPER a WMS ping"
        iifname "wg0" ip saddr 10.20.20.0/24 oifname "vlan30" ip daddr 10.10.30.10 tcp dport { 80, 443 } accept comment "Site2 a WMS web"
        iifname "wg0" ip saddr 10.20.20.0/24 oifname "vlan30" ip daddr 10.10.30.10 icmp type echo-request accept comment "Site2 a WMS ping"
        iifname { "vlan10", "vlan20", "vlan30" } oifname "eth13" accept comment "Salida a Internet via FortiGate"
        limit rate 10/minute log prefix "NEXLOG-FWD-DROP " level info
        counter drop
    }
}

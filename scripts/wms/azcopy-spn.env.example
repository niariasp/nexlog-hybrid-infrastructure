# NexLog Chile - Configuracion de AzCopy mediante Service Principal
# Plantilla de referencia. NO contiene credenciales reales.
# Archivo operativo: /root/nexlog-secrets/azcopy-spn.env
# Permisos requeridos del archivo operativo: 600

export AZCOPY_AUTO_LOGIN_TYPE=SPN
export AZCOPY_SPA_APPLICATION_ID="REEMPLAZAR_APPLICATION_ID"
export AZCOPY_TENANT_ID="REEMPLAZAR_TENANT_ID"
export AZCOPY_SPA_CERT_PATH="/root/nexlog-secrets/wms-sp-auth-v2.pfx"
export AZCOPY_SPA_CERT_PASSWORD="REEMPLAZAR_CON_SECRETO_LOCAL"
